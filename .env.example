# Browser resume checking needs no API key. Legacy adapters are not publicly callable.
# Server-side credentials only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Legacy adapter selection, unused by the browser checker.
AI_REVIEW_PROVIDER=
# Gemini uses Google's API. Student use remains disabled pending audience-term verification.
GEMINI_API_KEY=
# Legacy model setting. This does not activate student processing.
GEMINI_MODEL=
OPENAI_MODEL=gpt-4.1-mini
# Local SQLite for a persistent Node host; use libsql://... + token for Turso/serverless.
DATABASE_URL=file:./data/hire.db
DATABASE_AUTH_TOKEN=
CRON_SECRET=
ADMIN_SECRET=
RATE_LIMIT_SECRET=
# Vercel automatically uses its trusted x-vercel-forwarded-for header.
# Other hosts: set only a client-IP header the host overwrites; blank uses a shared limit.
TRUSTED_IP_HEADER=
# Production site origin, also used by scheduled GitHub Actions.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional override: unset uses verified defaults; explicit empty disables collection.
# To collect all connected sources, use the following value:
OPPORTUNITY_SOURCE_IDS=brampton-careers,brampton-volunteer,brampton-library,brampton-library-volunteer,brampton-youth-cabinet,brampton-summer-company,skills-ontario-brampton-camps,hack-club-community,energymag-internship,building-u-internship,launchx-online-summer,yale-young-global-scholars,diamond-challenge,waterloo-math-contests,microsoft-learning-paths,adplist-mentoring,coding-coach-mentorship,hack-club-leadership,hack-club-project-programs,mississauga-careers,food-banks-mississauga-youth,canadian-cadets-registration,toronto-library-literacy-volunteers,toronto-ltc-youth-volunteers,bgc-peel-youth-intakes,mississauga-current-youth-volunteers,ajax-careers,ajax-library-paid-pages,second-harvest-student-volunteers,toronto-youth-cabinet-working-groups,richmond-hill-youth-jobs
# Optional approved JSON/ICS feed sources are configured in data/sources.json.
# Publish a contact address for privacy requests before launch.
PRIVACY_CONTACT_EMAIL=
SITE_OPERATOR_NAME=HIRE Education
